<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Self-hosted deployments choose HTTP or HTTPS. HTTPS always validates
         certificate chains, validity and hostnames using Android's trust policy. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

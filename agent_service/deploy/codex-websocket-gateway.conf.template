# Opt-in companion to codex-gateway.conf.template. Render BOTH upstreams:
# CODEX_UPSTREAM = existing API HTTP listener, CODEX_WS_UPSTREAM = the same
# API process's COLLAB_AGENT_CODEX_WEBSOCKET_PORT. No host/public port.
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
    # Keep diagnostics bounded: framing metadata, never URLs, headers or bodies.
    map $http_content_length $codex_content_length {
        default invalid;
        "" absent;
        "~^[0-9]{1,20}$" $http_content_length;
    }
    map $http_transfer_encoding $codex_transfer_encoding {
        default other;
        "" absent;
        ~*^chunked$ chunked;
    }
    map $upstream_http_content_length $codex_upstream_content_length {
        default invalid;
        "" absent;
        "~^[0-9]{1,20}$" $upstream_http_content_length;
    }
    map $upstream_http_transfer_encoding $codex_upstream_transfer_encoding {
        default other;
        "" absent;
        ~*^chunked$ chunked;
    }
    log_format codex_diagnostics escape=json '{"event":"codex_gateway","request_id":"$request_id","request_bytes_including_headers":$request_length,"content_length":"$codex_content_length","transfer_encoding":"$codex_transfer_encoding","status":$status,"upstream_status":"$upstream_status","upstream_bytes_sent":"$upstream_bytes_sent","upstream_content_length":"$codex_upstream_content_length","upstream_transfer_encoding":"$codex_upstream_transfer_encoding","seconds":$request_time,"upstream_seconds":"$upstream_response_time"}';
    access_log /dev/stdout codex_diagnostics;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 128m;
    # Refuse a marked HTTP fallback before proxying any uploaded history.
    map "$request_method:$http_x_difysf_require_incremental" $codex_reject_full_post {
        default 0;
        ~^POST:.+ 1;
    }
    # Every proxied request gets its own connection: POSTs are sent with `Connection: close`, and since nginx 1.29.7 an
    # upstream block caches idle connections unless told not to. A cached connection the API has already finished with
    # (it parsed a `Connection: close` request) makes the next request a parser error, an empty 400.
    upstream codex_http { server ${CODEX_UPSTREAM}; keepalive 0; }
    upstream codex_socket { server ${CODEX_WS_UPSTREAM}; keepalive 0; }
    map $request_method $codex_upstream { default codex_http; GET codex_socket; }
    map "$request_method:$http_upgrade" $codex_connection { default close; ~*^GET:websocket$ upgrade; }
    server {
        listen 3128;
        location = /inner/agent/codex/v1/responses {
            if ($request_method !~ ^(GET|POST)$) { return 405; }
            if ($is_args != "") { return 403; }
            default_type application/json;
            if ($codex_reject_full_post) { return 400 '{"error":{"code":"incremental_required","message":"This operation requires the incremental WebSocket transport"}}'; }
            proxy_pass http://$codex_upstream;
            proxy_http_version 1.1;
            proxy_pass_request_headers off;
            proxy_set_header Host $proxy_host;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Content-Type application/json;
            proxy_set_header Accept text/event-stream;
            proxy_set_header X-Request-ID $request_id;
            add_header X-Request-ID $request_id always;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $codex_connection;
            proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;
            proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;
            proxy_set_header OpenAI-Beta $http_openai_beta;
            proxy_set_header session-id $http_session_id;
            proxy_set_header thread-id $http_thread_id;
            proxy_set_header X-DifySF-Require-Incremental $http_x_difysf_require_incremental;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_ignore_client_abort off;
            proxy_read_timeout 10800s;
            proxy_send_timeout 60s;
        }
        location / { return 403; }
    }
}

# Render CODEX_UPSTREAM as the trusted API service's host:port before startup.
# Attach this container only to the API network and supervisor-owned internal
# sandbox networks. No host ports, Docker socket or provider keys are needed.
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
    log_format codex_size 'length=$request_length content_length=$http_content_length seconds=$request_time status=$status upstream=$upstream_status';
    access_log /dev/stdout codex_size;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 128m;
    server {
        listen 3128;
        location = /inner/agent/codex/v1/responses {
            if ($request_method != POST) { return 405; }
            if ($is_args != "") { return 403; }
            proxy_pass http://${CODEX_UPSTREAM};
            proxy_http_version 1.1;
            proxy_pass_request_headers off;
            proxy_set_header Host ${CODEX_UPSTREAM};
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Content-Type application/json;
            proxy_set_header Accept text/event-stream;
            proxy_set_header X-DifySF-Require-Incremental $http_x_difysf_require_incremental;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_ignore_client_abort off;
            proxy_read_timeout 10800s;
            proxy_send_timeout 60s;
        }
        location / { return 403; }
    }
}

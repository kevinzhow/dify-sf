              "start",
              "name"
            ]
          }
        }
      ],
      "user_actions": [
        {
          "id": "approve",
          "title": "Approve it"
        }
      ]
    },
    "values": {
      "reply": "Yes"
    },
    "action": "approve",
    "mapping": {
      "hi.#start.name#": [
        "start",
        "name"
      ]
    },
    "defaults": {
      "reply": "World"
    },
    "rendered": "Hello World: {{#$output.reply#}}",
    "expected_inputs": {
      "reply": "Yes"
    },

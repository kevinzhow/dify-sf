# Release build of collab-server. Build and runtime stages use the same Swift 6.4 / Ubuntu base (same glibc).
FROM swift:6.4 AS build
WORKDIR /src
# The whole package: SwiftPM validates every target directory (incl. Tests) even for a single product.
COPY server/ ./
RUN swift build -c release --product collab-server

FROM swift:6.4-slim
COPY --from=build /src/.build/release/collab-server /usr/local/bin/collab-server
# Protocol 1.9: the vendored model provider definitions (SwiftPM resource bundle of CollabModels), found next to the binary.
COPY --from=build /src/.build/release/DifySF_CollabModels.bundle /usr/local/bin/DifySF_CollabModels.bundle
USER nobody
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/collab-server"]

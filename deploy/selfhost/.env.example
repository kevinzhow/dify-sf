# deploy/selfhost/.env: what init.sh writes (generate the real one with ./init.sh; never commit it).

# Where people reach this installation: http://host[:port], or https://domain.
PUBLIC_URL=https://dify.example.com
# What Caddy serves: :80 = plain HTTP for any address (also behind your own HTTPS proxy); a domain = HTTPS with a
# certificate Caddy obtains (Let's Encrypt). ACME_EMAIL receives its expiry notices (optional).
DIFYSF_SITE=dify.example.com
ACME_EMAIL=you@example.com
HTTP_PORT=80
HTTPS_PORT=443
# docker-compose.yml, plus :https.yml when Caddy does HTTPS itself (publishes port 443).
COMPOSE_FILE=docker-compose.yml:https.yml

# Keys and passwords: random, generated by init.sh. COLLAB_SECRETS_KEY is base64 of 32 bytes and decrypts the stored
# model credentials and secret variables: back it up with the database. COLLAB_FILES_SIGNING_KEY signs file links.
POSTGRES_PASSWORD=
COLLAB_SECRETS_KEY=
COLLAB_FILES_SIGNING_KEY=
PLUGIN_DAEMON_KEY=
PLUGIN_INNER_API_KEY=
SANDBOX_KEY=
REDIS_PASSWORD=
AGENT_SERVICE_KEY=
AGENT_SANDBOX_SUPERVISOR_KEY=

# Outgoing mail. Empty SMTP_HOST = no mail (password reset and mailed forms are then unavailable).
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls

# Agent v2 nodes: ./enable-agent.sh [--codex] sets AGENT_ENABLED=true and COMPOSE_PROFILES=agent (and adds :codex.yml
# to COMPOSE_FILE with --codex). The sandboxes' networks come from AGENT_SANDBOX_SUBNET_POOL.
AGENT_ENABLED=false
COMPOSE_PROFILES=
DOCKER_GID=999
AGENT_SANDBOX_SUBNET_POOL=10.213.0.0/16

COLLAB_MODELS_VALIDATE=true
PIP_MIRROR_URL=
LOG_LEVEL=info
